# SnapSafe AI - Environment Configuration
# Note: SnapSafe AI runs 100% locally on-device. No cloud AI keys are required.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# OCR Engine Mode: 'auto', 'rapidocr', 'qualcomm_aihub', or 'synthetic'
OCR_PROVIDER=auto

# Redaction Default: 'blur', 'pixelate', or 'blackout'
DEFAULT_REDACTION_STYLE=blur

# Zero-Cloud Enforcement (Strict Local Invariant)
ALLOW_EXTERNAL_EGRESS=false
